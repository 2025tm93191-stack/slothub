    {
      "name": "1. Setup catalog and slots (Scheduling)",
      "item": [
        {
          "name": "Create tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{schedulingUrl}}/api/v1/tenants",
            "description": "",
