# Payment service (mock gateway) — copy to .env for local runs (real environment variables take precedence)
ASPNETCORE_URLS=http://0.0.0.0:5103
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5440;Database=payment_db;Username=payment_user;Password=payment_pw
DB_MIGRATE_ON_STARTUP=true

# Failure injection (also changeable at runtime: PUT /api/v1/admin/chaos)
# CHAOS_FAILURE_MODE: DECLINE (402, payment stored as FAILED) or ERROR (503, gateway down, nothing stored)
CHAOS_FAILURE_RATE=0
CHAOS_LATENCY_MS=0
CHAOS_FAILURE_MODE=DECLINE

# BR4: how long idempotency keys are kept; when an IN_PROGRESS key counts as abandoned
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=60

Serilog__MinimumLevel__Default=Information
