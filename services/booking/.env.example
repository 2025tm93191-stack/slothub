# Booking service — copy to .env for local runs (real environment variables take precedence)
ASPNETCORE_URLS=http://0.0.0.0:5102
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5440;Database=booking_db;Username=booking_user;Password=booking_pw
DB_MIGRATE_ON_STARTUP=true

# Downstream services
Services__Scheduling__BaseUrl=http://localhost:5101
Services__Payment__BaseUrl=http://localhost:5103
Services__Notification__BaseUrl=http://localhost:5104

# Resilience for Scheduling/Payment calls: per-attempt timeout, retries (exponential backoff + jitter), overall budget
HTTP_ATTEMPT_TIMEOUT_SECONDS=2
HTTP_MAX_RETRIES=3
HTTP_TOTAL_TIMEOUT_SECONDS=20

# BR3: refuse to start a payment if the hold expires within this many seconds
HOLD_SAFETY_MARGIN_SECONDS=3
# Max duration of one pay/cancel operation on a booking (lease)
BOOKING_LEASE_SECONDS=60
# Background jobs
HOLD_SWEEP_INTERVAL_SECONDS=5
OUTBOX_POLL_INTERVAL_SECONDS=2
# BR4: how long idempotency keys are kept; when an IN_PROGRESS key counts as abandoned
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=60

Serilog__MinimumLevel__Default=Information
