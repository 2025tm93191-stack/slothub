# Notification service (mock SMS/email) — copy to .env for local runs and set the password to the one in the root .env (real environment variables take precedence)
ASPNETCORE_URLS=http://0.0.0.0:5104
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5440;Database=notification_db;Username=notification_user;Password=CHANGE_ME_notification
DB_MIGRATE_ON_STARTUP=true

# Delivery retries: delay = base x 2^(attempt-1), capped at 60 s; DEAD after max attempts
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_RETRY_BASE_SECONDS=2
NOTIFY_POLL_INTERVAL_SECONDS=2

# Provider failure injection (also changeable at runtime: PUT /api/v1/admin/chaos)
CHAOS_FAILURE_RATE=0
CHAOS_LATENCY_MS=0
CHAOS_FAILURE_MODE=ERROR

Serilog__MinimumLevel__Default=Information
