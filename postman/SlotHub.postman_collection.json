              "mode": "raw",
              "raw": "{\n  \"name\": \"Sunrise Dental {{$randomInt}}\",\n  \"timeZone\": \"Asia/Kolkata\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
