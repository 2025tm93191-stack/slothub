# Scheduling service — copy to .env for local runs (real environment variables take precedence)
ASPNETCORE_URLS=http://0.0.0.0:5101
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5440;Database=scheduling_db;Username=scheduling_user;Password=scheduling_pw
DB_MIGRATE_ON_STARTUP=true

# BR2: seconds a hold lasts before it expires
HOLD_TTL_SECONDS=30
# Challenge 3B: how often the expiry worker sweeps due holds
HOLD_SWEEP_INTERVAL_SECONDS=5

Serilog__MinimumLevel__Default=Information
