                  "pm.collectionVariables.set(\"tenantId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create resource",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
