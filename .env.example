# docker compose settings. Copy to .env (git-ignored) and replace every CHANGE_ME value:
#   cp .env.example .env
# Compose refuses to start while a required password is missing.
# The passwords are applied when the PostgreSQL volume is first created; to change them later,
# run `docker compose down -v` (deletes the data) and start again.

POSTGRES_PORT=5440
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_admin

# One login per service database (database-per-service)
SCHEDULING_DB_PASSWORD=CHANGE_ME_scheduling
BOOKING_DB_PASSWORD=CHANGE_ME_booking
PAYMENT_DB_PASSWORD=CHANGE_ME_payment
NOTIFICATION_DB_PASSWORD=CHANGE_ME_notification

# Image version tag and OCI labels
SLOTHUB_VERSION=1.0.0
GIT_REVISION=unknown
